# Copy to .env.local for local development. Set the same values in Vercel → Project → Settings → Environment Variables.
# Never commit real keys.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the scheduled jobs to score games and crown winners.
SUPABASE_SERVICE_ROLE_KEY=

# API-Football (api-football.com) → Dashboard → API key
API_FOOTBALL_KEY=
# Premier League is league 39. The season is the year it starts (2026 = 2026/27).
API_FOOTBALL_LEAGUE_ID=39
API_FOOTBALL_SEASON=2026
SEASON_ID=2026-27
# International competitions for Call It International, as API-Football league ids, comma-separated
# (for example friendlies, World Cup qualifiers, AFCON qualifiers, Nations League). Check the ids in the
# API-Football dashboard before launch. Their season is usually the calendar year.
API_FOOTBALL_INT_LEAGUES=
API_FOOTBALL_INT_SEASON=2026

# Any long random string. Vercel sends it to the scheduled jobs; nothing else can run them.
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=https://www.crystalballfc.com
